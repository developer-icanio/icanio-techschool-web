# Public site
# NEXT_PUBLIC_SITE_URL=https://techschool.icanio.com   # optional; defaults to the Vercel production domain

# Lead form email (Resend). Without these, submissions are only logged.
RESEND_API_KEY=
RESEND_FROM="Icanio Tech School <noreply@icanio.com>"
# LEAD_TO_OVERRIDE=you@example.com   # send every lead here while testing

# Admin dashboard (/admin)
DATABASE_URL=                 # Postgres (Supabase/Neon). Empty in dev = local PGlite in .data/
DATABASE_CA_CERT=             # optional: Supabase root CA (Dashboard > Database > SSL) so the server certificate is verified too
AUTH_SECRET=                  # openssl rand -base64 32
AUTH_GOOGLE_ID=               # Google OAuth client (redirect URI: <site>/api/auth/callback/google)
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=bd@icanio.com    # permanent owners, comma separated
CRON_SECRET=                  # protects /api/cron/* (and full /api/health details)
# AUTH_DEV_LOGIN=1            # localhost only: password-less login for testing
# ADMIN_NO_LOGIN=1            # localhost only: open /admin with no login at all

# Google PageSpeed Insights API key (dashboard speed tests)
GOOGLE_PAGESPEED_API_KEY=
# Optional: site PageSpeed tests run against (defaults to the site URL)
# PAGESPEED_BASE_URL=https://icaniotechschool.vercel.app

# Dashboard uploads: Cloudflare R2 (Dashboard > R2 > your bucket)
R2_ACCOUNT_ID=                # Cloudflare account ID (R2 overview page)
R2_ACCESS_KEY_ID=             # R2 > Manage API tokens > Object Read & Write, this bucket only
R2_SECRET_ACCESS_KEY=
R2_BUCKET=                    # e.g. icanio-techschool
R2_PUBLIC_URL=                # bucket public URL, e.g. https://pub-xxxx.r2.dev or https://files.techschool.icanio.com
